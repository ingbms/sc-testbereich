---
import Layout from '../../layouts/Layout.astro';
import PageHeading from '../../components/PageHeading.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import CallToAction from '../../components/CallToAction.astro';
import LiveContent from '../../components/LiveContent.astro';
import { emailLink } from '../../data/site';
import { offers, url } from '../../data/site';
---
<Layout title="Angebote"><PageHeading title="Entwicklung, die zu dir passt." eyebrow="Führung · Teams · Persönlichkeit" intro="Jedes Anliegen beginnt mit einer Begegnung. Gemeinsam finden wir heraus, welches Training dich oder dein Team weiterbringen kann." /><div class="container section-space"><div class="offers-grid">{offers.map(offer => <a class="offer-card" href={url(`angebote/${offer.slug}/`)}><Photo source={offer.image} position={offer.position} /><div class="offer-card-content"><h2>{offer.title}</h2><p>{offer.summary}</p><span class="red-rule"></span><span class="text-link">Mehr erfahren <Icon name="arrow" /></span></div></a>)}</div><div class="outcomes"><h2>Ein gemeinsamer Ausgangspunkt</h2><p>Wir arbeiten mit den Pferden vom Boden aus. Reiterfahrung ist nicht erforderlich. Anliegen, Umfang und Ablauf stimmen wir persönlich ab.</p></div><p class="voices-reference">Du möchtest wissen, wie Teilnehmende das Training erleben? <a href={url('stimmen/')}>Stimmen lesen →</a></p><section id="termine"><p class="eyebrow">Termine & individuelle Trainings</p><h2 style="margin: 12px 0 25px">Zeit für neue Perspektiven.</h2><LiveContent kind="termine" /><div class="practical"><p>Du hast Fragen zu einem Termin oder suchst ein passendes Format? Schreib mir dein Anliegen.</p><a class="button" href={emailLink('Anfrage zu Terminen und Trainings')}>Termin anfragen →</a></div></section></div><CallToAction /></Layout>
