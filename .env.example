# Local preview defaults to /. GitHub Actions sets BASE_PATH for project Pages.
SITE_URL=https://ingbms.github.io
BASE_PATH=/sc-testbereich
# Public content Apps Script /exec endpoint (only published fields).
PUBLIC_CONTENT_ENDPOINT=
# Separate statistics Apps Script /exec endpoint. Requires explicit consent.
PUBLIC_ANALYTICS_ENDPOINT=
# Keep false until deployment, privacy information and deletion trigger verified.
PUBLIC_ANALYTICS_ENABLED=false
