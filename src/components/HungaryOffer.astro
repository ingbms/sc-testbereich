---
import Photo from './Photo.astro';
import { url } from '../data/site';
---
<section class="split-intro hungary-offer" aria-labelledby="ungarn-angebot">
  <Photo source="HU/a090eaf0-96fb-4404-b240-aad6471dfc85-1_all_28581.jpg" position="center 20%" />
  <div>
    <p class="eyebrow">Seminar & Auszeit</p>
