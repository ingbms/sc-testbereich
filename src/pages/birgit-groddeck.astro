---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import Icon from '../components/Icon.astro';
import Gallery from '../components/Gallery.astro';
import CallToAction from '../components/CallToAction.astro';
import { url, emailLink } from '../data/site';
import '../styles/about.css';
const qualifications = [
  { slug: 'betriebswirtin-hwk', title: 'Betriebswirtin (HWK)', label: 'Betriebswirtschaft & Führung', text: 'Für meine Leistungen in der Abschlussprüfung zur Betriebswirtin (HWK) wurde ich mit dem Meisterpreis der Bayerischen Staatsregierung ausgezeichnet.', detail: 'Meisterpreis · Urkunde vom 12. Januar 2010', alt: 'Urkunde über den Meisterpreis der Bayerischen Staatsregierung für Birgit Groddeck, Betriebswirtin (HWK)', link: 'Meisterpreis-Urkunde ansehen' },
  { slug: 'open4life-coach', title: 'Klientenzentriertes Coaching', label: 'Coaching & Kommunikation', text: 'Die Coachingausbildung bei OPEN4LIFE in München umfasste 100 Stunden in fünf Modulen. Zu den Inhalten gehörten Persönlichkeitsentwicklung, Gesprächsführung, soziale Kompetenz und praktische Übungen mit Coachingklienten.', detail: 'OPEN4LIFE · Ausbildungsnachweis 2011', alt: 'OPEN4LIFE-Zertifikat für Birgit Groddeck über die erfolgreiche Teilnahme an der Ausbildung in klientenzentriertem Coaching', link: 'Coaching-Zertifikat ansehen' },
];
---
<Layout title="Birgit Groddeck">
  <PageHeading title="Birgit Groddeck" eyebrow="Trainerin. Autorin. Sparringspartnerin." intro="Menschen begleiten. Entwicklung ermöglichen. Mit Klarheit, Erfahrung und einem offenen Blick für das Gegenüber." />
  <div class="container section-space">
    <div class="split-intro"><div class="portrait-placeholder"><Icon name="person" /><span>Birgit Groddeck</span><small>Ein neues Portrait folgt</small></div><div><h2>Erfahrung mit Menschen.<br />Verbundenheit mit Pferden.</h2><p>Ich bin Birgit Groddeck, Inhaberin von Smiling Relations und Coach für Persönlichkeit, Kommunikation und Ausstrahlung. Meine Arbeit verbindet betriebswirtschaftliches Wissen, unternehmerische Führungserfahrung und die Begegnung mit Pferden.</p><p>Als Betriebswirtin (HWK) mit einer Ausbildung in klientenzentriertem Coaching bringe ich unterschiedliche Perspektiven zusammen: einen klaren Blick auf berufliche Aufgaben und Aufmerksamkeit für den Menschen dahinter.</p><a class="text-link" href={emailLink('Birgit persönlich kennenlernen')}>Ins Gespräch kommen →</a></div></div>
    <div class="article-grid about-experience"><section><h2>Unternehmerisch denken.</h2><p>Betriebswirtschaft und Führungserfahrung gehören zu meinem beruflichen Hintergrund. Sie prägen meinen Blick auf die Fragen, mit denen Menschen in verantwortlichen Positionen ins Training kommen.</p></section><section><h2>Wissen verständlich machen.</h2><p>Zu meinem beruflichen Weg gehören Tätigkeiten als Trainerin bei der Handwerksinnung und als Dozentin an der Handwerkskammer München. Wissen weiterzugeben und Menschen beim Lernen zu begleiten, verbindet diese Erfahrungen mit meiner Coachingarbeit.</p></section><section><h2>Mit Pferden lernen.</h2><p>Ich bringe langjährige Reiterfahrung und Erfahrung als Berittführerin sowie im Reiten mit Menschen mit Behinderung mit. Bei Smiling Relations arbeiten wir mit den Pferden vom Boden aus. Reiterfahrung ist dafür nicht erforderlich.</p></section></div>
    <section class="qualifications" id="qualifikationen" aria-labelledby="qualifications-title">
      <div class="qualifications-heading"><p class="eyebrow">Ausbildung & Auszeichnung</p><h2 id="qualifications-title">Wissen, das meine Arbeit trägt.</h2><p>Betriebswirtschaft und Coaching bilden zwei Grundlagen meiner Arbeit. Hier findest du die zugehörigen Nachweise.</p></div>
      <div class="qualification-grid">{qualifications.map(item => <article class="qualification-card">
        <a class="qualification-document" href={url(`brand/${item.slug}.jpg`)} data-gallery data-kind="image" data-caption={`${item.title} – ${item.detail}`} aria-label={`${item.link} – vergrößern`}><img src={url(`brand/${item.slug}-preview.webp`)} alt={item.alt} width="480" height="675" loading="lazy" /><span>Nachweis ansehen <Icon name="arrow" /></span></a>
        <div class="qualification-copy"><p class="eyebrow">{item.label}</p><h3>{item.title}</h3><p>{item.text}</p><p class="qualification-detail">{item.detail}</p></div>
      </article>)}</div>
    </section>
    <p class="voices-reference">Persönliche Einblicke in meine Arbeit geben die Menschen, die ich begleitet habe. <a href={url('stimmen/')}>Stimmen lesen →</a></p>
    <section class="book" id="buch"><img src={url('brand/buch.webp')} alt="Buchcover: Smiling Relations – Führungsqualitäten stärken von Birgit Groddeck" width="175" height="240" loading="lazy" /><div><p class="eyebrow">Impulse zum Weiterlesen</p><h2>Smiling Relations<br />Führungsqualitäten stärken</h2><p>Wie lässt sich mit positiver Kommunikation die eigene Stärke erkennen und entwickeln? In ihrem Buch verbindet Birgit Groddeck diese Frage mit den Erfahrungen aus der Arbeit mit Pferden.</p><p>Erhältlich über den Buchhandel.</p><small>Klecks Verlag · ISBN 978-3-944050-22-5</small></div></section>
    <section class="split-intro" id="presse"><a href={url('brand/presse.jpg')} data-gallery data-kind="image" data-caption="Kommunikations-Workshop mit Pferd – Pressebericht von Simone Thyssen"><img src={url('brand/presse-preview.webp')} alt="Zeitungsausschnitt mit der Überschrift Kommunikations-Workshop mit Pferd" width="600" height="636" loading="lazy" /></a><div><p class="eyebrow">Ein Blick von außen</p><h2>Kommunikations-Workshop mit Pferd</h2><p>Ein Pressebericht von Simone Thyssen gibt Einblick in die Arbeit von Smiling Relations und in ein Training mit Pferden.</p><a class="text-link" href={url('brand/presse.jpg')} target="_blank" rel="noopener">Den Zeitungsausschnitt lesen ↗</a></div></section>
    <section id="galerie"><p class="eyebrow">Eindrücke. Momente. Entwicklung.</p><h2>Menschen. Pferde. Echte Momente.</h2><p style="margin: 18px 0 30px">Einblicke in Begegnungen und gemeinsame Zeit in Deutschland und Ungarn.</p><nav class="gallery-tabs" aria-label="Galeriebereiche"><a href="#galerie-deutschland">Deutschland</a><a href="#galerie-ungarn">Ungarn</a></nav><section id="galerie-deutschland"><h3 style="margin: 30px 0 22px">Deutschland</h3><Gallery country="DE" /></section><section id="galerie-ungarn"><h3 style="margin: 45px 0 22px">Ungarn</h3><p style="margin-bottom: 24px"><a class="text-link" href={url('angebote/ungarn/')}>Die Auszeit in Ungarn entdecken →</a></p><Gallery country="HU" /></section></section>
  </div><CallToAction />
</Layout>
