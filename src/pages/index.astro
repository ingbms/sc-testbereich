---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Gallery from '../components/Gallery.astro';
import LiveContent from '../components/LiveContent.astro';
import CallToAction from '../components/CallToAction.astro';
import { url, offers } from '../data/site';
import '../styles/home.css';
---
<Layout>
  <section class="hero">
    <Photo source="HU/1000196338.jpg" class="hero-image" eager />
    <div class="container hero-content"><p class="eyebrow">Für Führungskräfte · Teams · Unternehmen</p><h1>Besser kommunizieren.<br />Echt bewegen.</h1><span class="red-rule"></span><p class="intro">Mit Pferden als unmittelbaren Feedbackpartnern zu klarer Kommunikation, bewusster Führung und besserer Zusammenarbeit.</p><a class="button" href={url('ansatz/')}>Jetzt mehr erfahren <Icon name="arrow" /></a><a class="hero-book" href={url('birgit-groddeck/#buch')}>Impulse zum Weiterlesen: <span>Das Buch von Birgit Groddeck ↗</span></a></div>
    <p class="hero-note handwritten">Echte<br />Begegnung<br />verändert.</p>
  </section>
  <section class="container benefits" aria-label="Was sich entwickeln kann">
    {[
      ['chat','Klarer kommunizieren','Authentisches Feedback für echte Verständigung.'],
      ['heart','Persönlich wachsen','Mehr Selbstbewusstsein, Klarheit und Wirkung.'],
      ['people','Besser zusammenarbeiten','Starke Teams durch Vertrauen und wertschätzende Kommunikation.'],
    ].map(([icon,title,text]) => <div class="benefit"><span class="icon-circle"><Icon name={icon} /></span><div><h2>{title}</h2><p>{text}</p></div></div>)}
  </section>
  <section class="method"><div class="method-photo"><Photo source="HU/1000196355.jpg" /><blockquote>„Pferde urteilen nicht.<br />Sie reagieren ehrlich –<br />und genau das macht sie zu besonderen Lehrmeistern.“</blockquote></div><div class="method-content"><div><h2>Das Pferd als Feedbackpartner</h2><p>Pferde reagieren unmittelbar auf unsere Körpersprache und Haltung. Ihr Verhalten gibt direktes Feedback. Gemeinsam betrachten wir diese Rückmeldung und entwickeln neue Perspektiven für Führung und Zusammenarbeit.</p><a class="text-link" href={url('ansatz/')}>Mehr über den Ansatz <Icon name="arrow" /></a></div><div class="method-points"><div><Icon name="leaf" /><span>Ehrlich.<br />Unmittelbar.</span></div><div><Icon name="eye" /><span>Wertfrei.<br />Authentisch.</span></div><div><Icon name="people" /><span>Stark in der Wirkung.<br />Nachhaltig im Alltag.</span></div></div></div></section>
  <section class="container offers-grid" aria-label="Unsere Anwendungsfelder">
    {offers.map(offer => <a class="offer-card" href={url(`angebote/${offer.slug}/`)}><Photo source={offer.image} size="thumb" position={offer.position} /><div class="offer-card-content"><h2>{offer.title}</h2><p>{offer.summary}</p><span class="red-rule"></span><span class="text-link">Mehr erfahren <Icon name="arrow" /></span></div></a>)}
  </section>
  <aside class="container hungary-teaser"><a href={url('angebote/ungarn/')}><span><strong>Seminarreise Ungarn</strong><span class="teaser-separator"> – </span>Lernen, erleben und zur Ruhe kommen</span><Icon name="arrow" /></a></aside>
  <section class="container about-strip"><div class="portrait-placeholder" aria-label="Platz für das neue Portrait von Birgit Groddeck"><Icon name="person" /><span>Birgit Groddeck</span><small>Ein neues Portrait folgt</small></div><div class="about-copy"><h2>Birgit Groddeck</h2><p class="eyebrow">Trainerin. Autorin. Sparringspartnerin.</p><p>Ich begleite Menschen, Teams und Organisationen mit Pferden, langjähriger Führungserfahrung und einem klaren Blick für das Wesentliche. Meine Arbeit verbindet echte Begegnung mit nachhaltiger Entwicklung – für mehr Menschlichkeit in Leadership und Zusammenarbeit.</p><a class="button button-outline" href={url('birgit-groddeck/')}>Mehr über mich <Icon name="arrow" /></a></div><ul class="about-facts about-facts--evidence" aria-label="Belegte Qualifikationen von Birgit Groddeck"><li><a href={url('birgit-groddeck/#qualifikationen')}><Icon name="cap" /><span><strong>Betriebswirtin (HWK)</strong><small>Meisterpreis der Bayerischen Staatsregierung</small></span></a></li><li><a href={url('birgit-groddeck/#qualifikationen')}><Icon name="people" /><span><strong>100 Stunden Coachingausbildung</strong><small>Klientenzentriertes Coaching · OPEN4LIFE</small></span></a></li></ul></section>
  <section class="container gallery-preview" id="galerie"><div class="gallery-heading"><p class="eyebrow">Eindrücke. Momente. Entwicklung.</p><h2>Galerie</h2><p class="subheading">Fotos &amp; Clips</p><p>Einblicke in meine Arbeit –<br />in Deutschland und Ungarn.<br />Menschen. Pferde. Echte Momente.</p><a class="button" href={url('birgit-groddeck/#galerie')}>Zur Galerie <Icon name="arrow" /></a></div>{[['DE','Deutschland','deutschland'],['HU','Ungarn','ungarn']].map(([country,title,slug]) => <div class="gallery-country"><div class="country-heading"><h3>{title}</h3><a href={url(country === 'HU' ? 'angebote/ungarn/' : `birgit-groddeck/#galerie-${slug}`)}>Alle anzeigen →</a></div><Gallery country={country} limit={4} compact /></div>)}</section>
  <section class="container voices" id="stimmen"><div><h2>Stimmen</h2><p>Echte Erfahrungen.<br />Nachhaltige Wirkung.</p><a class="text-link" href={url('stimmen/')}>Alle Stimmen lesen →</a></div><LiveContent kind="stimmen" limit={3} /></section>
  <CallToAction />
</Layout>
